#!/usr/bin/env bash

# use exit codes of failing commands
set -exo pipefail

configure_github_credentials() {
  local xtrace_enabled=false
  local gh_tok
  local netrc_path="${RPMBUILDER_NETRC_PATH:-/root/.netrc}"
  local curlrc_path="${RPMBUILDER_CURLRC_PATH:-/root/.curlrc}"

  # This script normally runs with `set -x`; never trace credential values.
  if [[ $- == *x* ]]; then
    xtrace_enabled=true
    set +x
  fi

  gh_tok="${GITHUB_TOKEN:-${GITHUB_API_TOKEN:-${LASTVERSION_GITHUB_API_TOKEN:-}}}"
  if [[ -n "${gh_tok}" ]]; then
    local old_umask
    old_umask="$(umask)"
    umask 077
    cat > "${netrc_path}" <<EOF
machine github.com
  login x-access-token
  password ${gh_tok}
machine codeload.github.com
  login x-access-token
  password ${gh_tok}
EOF
    echo "--netrc" > "${curlrc_path}"
    umask "${old_umask}"
    export GITHUB_API_TOKEN="${GITHUB_API_TOKEN:-${gh_tok}}"
    export GITHUB_TOKEN="${GITHUB_TOKEN:-${gh_tok}}"
  fi

  if [[ "${xtrace_enabled}" == "true" ]]; then
    set -x
  fi
}

repo_definition_file() {
  # Channels are not one-file-per-id: e.g. getpagespeed-extras-mainline is a
  # [section] inside getpagespeed-extras.repo, while -plesk/-ea4 ship their
  # own files. Print the path of whichever *.repo defines the section.
  local repo_id=$1
  local dir=$2
  local f
  for f in "${dir}"/*.repo; do
    [[ -f "$f" ]] || continue
    if grep -q "^\[${repo_id}\]" "$f"; then
      echo "$f"
      return 0
    fi
  done
  return 1
}

adopt_repo_section_from_rpmnew() {
  # The repo files are %config(noreplace) and getpagespeed-extras-release's
  # %post rewrites them in place (/redhat/ -> /amzn/ or /fedora/ on first
  # install; older releases hardcoded $releasever). RPM therefore parks every
  # later upgrade at <file>.rpmnew and the live file's channel list freezes at
  # whatever the base image shipped -- getpagespeed/lts:el7 froze it in
  # Sep 2024, so freenginx-mainline never reached el7 and refreshing the
  # release package could not help (it was already at the newest release).
  # Copy across just the missing [section], leaving the live file's own URL
  # rewrites intact.
  local repo_id=$1
  local dir=$2
  local rpmnew live section rewrite
  for rpmnew in "${dir}"/*.repo.rpmnew; do
    [[ -f "$rpmnew" ]] || continue
    grep -q "^\[${repo_id}\]" "$rpmnew" || continue
    live="${rpmnew%.rpmnew}"
    [[ -f "$live" ]] || continue
    section=$(awk -v id="[${repo_id}]" '
      $0 == id { inside = 1; print; next }
      inside && /^\[/ { exit }
      inside { print }
    ' "$rpmnew")
    [[ -n "$section" ]] || continue
    # Mirror the per-family path rewrite the release package applies in %post.
    rewrite=''
    if [[ $(rpm -E '%{amzn}' 2>/dev/null) =~ ^[0-9]+$ ]]; then
      rewrite='s@/redhat/@/amzn/@g'
    elif [[ $(rpm -E '%{fedora}' 2>/dev/null) =~ ^[0-9]+$ ]]; then
      rewrite='s@/redhat/@/fedora/@g'
    fi
    [[ -z "$rewrite" ]] || section=$(printf '%s\n' "$section" | sed "$rewrite")
    printf '\n%s\n' "$section" >> "$live"
    echo "Adopted ${repo_id} from $(basename "$rpmnew") into $(basename "$live")"
    return 0
  done
  return 1
}

ensure_requested_repo_definition() {
  local repo_id=$1
  local rhel=$2
  local etc_dir="${RPMBUILDER_REPO_ETC_DIR:-/etc/yum.repos.d}"
  local share_dir="${RPMBUILDER_REPO_SHARE_DIR:-/usr/share/getpagespeed}"
  local src

  if repo_definition_file "${repo_id}" "${etc_dir}" >/dev/null; then
    return 0
  fi

  if ! repo_definition_file "${repo_id}" "${share_dir}" >/dev/null; then
    echo "Repository ${repo_id} is absent; refreshing getpagespeed-extras-release"
    if command -v dnf5 >/dev/null 2>&1; then
      dnf5 upgrade --assumeyes getpagespeed-extras-release
    elif [[ "$rhel" -gt 0 && "$rhel" -le 7 ]]; then
      yum update --assumeyes getpagespeed-extras-release
    else
      dnf upgrade --assumeyes getpagespeed-extras-release
    fi
  fi

  # A refresh is a no-op when the release package is already current but its
  # repo file was parked at .rpmnew; take the section from there.
  if ! repo_definition_file "${repo_id}" "${etc_dir}" >/dev/null; then
    adopt_repo_section_from_rpmnew "${repo_id}" "${etc_dir}" ||
      adopt_repo_section_from_rpmnew "${repo_id}" "${share_dir}" || true
  fi

  if ! repo_definition_file "${repo_id}" "${etc_dir}" >/dev/null; then
    if src=$(repo_definition_file "${repo_id}" "${share_dir}"); then
      cp "${src}" "${etc_dir}/"
    fi
  fi

  if ! repo_definition_file "${repo_id}" "${etc_dir}" >/dev/null; then
    echo "Requested repository definition is unavailable: ${repo_id}" >&2
    return 1
  fi
}

# Unit tests source this file only to exercise helpers above.
if [[ "${RPMBUILDER_HELPERS_ONLY:-0}" == "1" ]]; then
  if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
  fi
  exit 0
fi

# `bc` is needed for floating point arithmetic, fail if not present
command -v bc > /dev/null 2>&1 || { echo "bc is required but not installed. Aborting." >&2; exit 1; }

SOURCES=${SOURCES-/sources}
OUTPUT=${OUTPUT-${SOURCES}}

# If a GitHub token is provided, configure netrc/curl for private source access.
configure_github_credentials

# The following is to support legacy prepare.sh scripts which call "yum" on "dnf" systems
# Creates a symlink to dnf if yum is not present
if [[ -f /usr/bin/dnf ]]; then
  if [[ ! -f /usr/bin/yum ]]; then
    ln -s /usr/bin/dnf /usr/bin/yum
  fi
fi

# Initialize default values for options and flags, but attempt to use env var
# if it is set
FORCE="${FORCE:-false}"
# Whether need to clean existing .spec files in rpm specs directory,
# useful when running multiple build commands in a flow
CLEAN=false

# Loop through the arguments
while [[ "$1" != "" ]]; do
    case $1 in
        --force )
            FORCE=true
            ;;
        --clean )
            CLEAN=true
            ;;
        --enable-repos )
            shift # Move to the next argument, which should be the value for --option
            if [[ -n $1 ]]; then
                ENABLE_REPOS=$1
            else
                echo "Error: --enable-repos requires a value."
                exit 1
            fi
            ;;
        * )
            echo "Invalid option: $1"
            exit 1
            ;;
    esac
    shift # Move to the next argument
done

RHEL=$(rpm -E "0%{?rhel}")
# Force decimal: "09" -> 9, "010" -> 10, "0" -> 0. The previous extglob
# strip needed `shopt -s extglob` and silently left "09", which then blew
# up `[[ ... -gt ... ]]` arithmetic as an invalid octal.
RHEL=$((10#${RHEL}))

# https://docs.oracle.com/cd/E93554_01/E69348/html/uek4-czc_xmc_xt.html
touch /var/lib/rpm/*

# enable specified repositories before build
if [[ -n ${ENABLE_REPOS} ]]; then
  # Refresh the narrowly scoped release package when a newly introduced
  # channel is absent from an older builder image, then install its definition.
  ensure_requested_repo_definition "${ENABLE_REPOS}" "${RHEL}"
  if command -v dnf5 > /dev/null 2>&1; then
    dnf5 config-manager setopt "${ENABLE_REPOS}".enabled=1
  elif [ "$RHEL" -gt "0" ] && [ "$RHEL" -le "7" ]; then  # if more than 0 and less or equal than 7
    yum-config-manager --enable "${ENABLE_REPOS}"
  else
    dnf config-manager --set-enabled "${ENABLE_REPOS}"
  fi
fi

# Use custom rpmlint config per repository, if such exists
[ -f "${SOURCES}/rpmlint.config" ] && cp -f "${SOURCES}"/rpmlint.config /etc/rpmlint/custom.config

mkdir -p /etc/rpmlint

# Detect rpmlint version once; empty if rpmlint not installed. The mutes
# below MUST be gated to the rpmlint version that introduced the escalation
# they compensate for — applying them unconditionally on older rpmlint
# (and on any future rpmlint that re-uses a check name) silently changes
# behavior across the entire build matrix.
RPMLINT_VER=""
if command -v rpmlint >/dev/null 2>&1; then
  RPMLINT_VER=$(rpmlint --version 2>&1 \
    | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
fi
# dotted-version >= compare via sort -V (portable to EL7's coreutils).
ver_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]; }

# rpmlint 2.7+: flags %{_sourcedir}/X as use-of-RPM_SOURCE_DIR; legitimate
# use in nginx-mod (in-tree sources copied during %prep) — mute on >=2.7.
if [ -n "${RPMLINT_VER}" ] && ver_ge "${RPMLINT_VER}" "2.7"; then
  printf 'setBadness("use-of-RPM_SOURCE_DIR", 0)\n' >> /etc/rpmlint/custom.config
  printf 'addFilter("use-of-RPM_SOURCE_DIR")\n'     >> /etc/rpmlint/custom.config
fi

# Mute rpmlint checks that have varying badness across versions but are
# either spurious for our packaging or surface long-standing project quirks:
#  - unused-rpmlintrc-filter: stale addFilter() lines per-distro
#  - spelling-error: nginx module descriptions legitimately mention
#    "conf"/"ngx"/"usr" which trip the en_US dictionary check
#  - no-changelogname-tag: generated-spec quirk (rpmlint flags this as E
#    even on rpmlint 1.x / 2.0)
# (description-line-too-long and invalid-license intentionally NOT muted —
#  they catch real packaging-quality issues. bogus-date in %changelog
#  likewise NOT muted: it indicates a packager typo and should fail the
#  build so the offending spec gets fixed.)
# setBadness is a no-op on older rpmlints that don't support it, so the
# mutes are safe to apply unconditionally.
{
  printf '\nsetBadness("unused-rpmlintrc-filter", 0)\n'
  printf 'setBadness("spelling-error", 0)\n'
  printf 'setBadness("no-changelogname-tag", 0)\n'
} >> /etc/rpmlint/custom.config

# rpmlint's TagsCheck imports python-enchant and instantiates a SpellChecker
# for en_US at startup. On distros where the enchant backend can't find an
# en_US dictionary (observed: amzn2023, where hunspell-en-US is installed but
# pyenchant's libenchant doesn't see it), rpmlint crashes with
# DefaultLanguageNotFoundError before producing any output. Pre-flight check
# the dict so we can disable rpmlint cleanly on those distros instead of
# letting the build fail on a check we don't actually care about anyway
# (spelling-error is already setBadness 0 above).
if [[ -n ${RPMLINT} && "${RPMLINT}" != 0 ]]; then
  if ! python3 -c 'import enchant; enchant.Dict("en_US")' >/dev/null 2>&1; then
    echo "[disable-rpmlint] python-enchant cannot load en_US dictionary; disabling rpmlint for this build" >&2
    export RPMLINT=0
  fi
fi

# Run optional per-repo file with extra build preparations needed like setting up more repos
[ -f "${SOURCES}"/prepare.sh ] && bash "${SOURCES}"/prepare.sh

# each repo can go with rpmmacros (useful for building multiple branches while retaining same spec)
[ -f "${SOURCES}"/rpmmacros ] \
  && cat "${SOURCES}"/rpmmacros >> /root/.rpmmacros \
  && chown root:root /root/.rpmmacros

# Use rpm instead of rpmbuild to avoid bad exit in EL6
RPM_BUILD_SOURCES=$(rpm --eval '%{_sourcedir}')
RPM_BUILD_RPMS=$(rpm --eval '%{_rpmdir}')
RPM_BUILD_SRPMS=$(rpm --eval '%{_srcrpmdir}')
RPM_BUILD_SPECS=$(rpm --eval '%{_specdir}')

if [ "$CLEAN" = true ]; then
  # clean existing source and .spec files
  rm -f "${RPM_BUILD_SPECS}"/*.spec
  rm -rf "${RPM_BUILD_SOURCES:?}"/*
fi
# copy any .spec filess to rpmbuild/SPECS directory
find "${SOURCES}" -mindepth 1 -maxdepth 1 -name "*.spec" \
    -exec cp -R {} "${RPM_BUILD_SPECS}"/. \;

# copy any non-spec files/dirs to rpmbuild/SOURCES directory
find "${SOURCES}" -mindepth 1 -maxdepth 1 ! -name "*.spec" \
    -exec cp -R {} "${RPM_BUILD_SOURCES}"/. \;

# fix permissions on working copy
chown root:root /root/rpmbuild

# VMOD tests during build:
# varnishd is dropping to user nobody/varnish, and as such doesn't have access in /root/
chmod 0755 /root

# Detect OS for distro-specific dependency installation logic
if [[ -f /etc/os-release ]]; then
  # shellcheck disable=SC1091 # The path is supplied by the build image.
  . /etc/os-release
fi

# With SCLO repos in place, yum-builddep might resolve "BuildRequires: gcc" to devtoolset-4-gcc
# In Docker image we pre-install build sys root (gcc) to mimic mock better and avoid this bad lookup
BUILDDEP_CMD="yum-builddep"
command -v dnf > /dev/null 2>&1 && BUILDDEP_CMD="dnf builddep"
RPMBUILD_SETARCH=""
if [[ -n ${SETARCH} && "${SETARCH}" != "x86_64" ]]; then
  # getting builddep to fetch i686 RPMs from x86_64 repo is no easy task :D
  RPMBUILD_SETARCH="setarch ${SETARCH}"
  echo x86_64 > /etc/yum/vars/basearch
fi

# Install build dependencies using zypper on openSUSE (dnf builddep is unreliable there)
zypper_builddep() {
  local spec_file=$1
  # Ensure metadata is fresh and keys are imported
  zypper --non-interactive --gpg-auto-import-keys refresh || true
  # Extract BuildRequires and install them
  local reqs
  if ! reqs=$(rpmspec -q --buildrequires "$spec_file"); then
    echo "Failed to parse buildrequires from ${spec_file}"
    return 1
  fi
  # If there are no BuildRequires, nothing to install – treat as success
  if [[ -z "${reqs}" ]]; then
    echo "No BuildRequires found in ${spec_file}; skipping zypper install."
    return 0
  fi
  # Collapse versioned expressions ("name >= 1.2" / "name = 1.2") into zypper
  # capability syntax ("name>=1.2") so word-splitting below yields one argument
  # per dependency instead of three.
  reqs=$(echo "${reqs}" | sed 's/ //g')
  # Use no-recommends to keep image lean; force-resolution to satisfy pkgconfig() virtuals
  # shellcheck disable=SC2086 # One package expression per line must become separate arguments.
  if ! zypper --non-interactive install --no-recommends --force-resolution ${reqs}; then
    echo "zypper failed to install some build dependencies for ${spec_file}"
    return 1
  fi
}

# Universal wrapper function for repoquery across different RHEL/CentOS versions
universal_repoquery() {
    local package=$1

    # Check if dnf or repoquery is available
    if command -v dnf > /dev/null 2>&1; then
        # RHEL 8+ and Fedora
        dnf repoquery -q "${package}"
    elif command -v repoquery > /dev/null 2>&1; then
        # RHEL 7 and below
        repoquery -q "${package}"
    else
        # If neither is available, return empty (indicating no packages found)
        echo ""
    fi
}

# Function to check if all packages from a spec file are present in the repository
check_packages_in_repo() {
    local spec_file=$1

    # Special handling for openSUSE/SLES builder images where zypper has full
    # visibility into SLES repos and dnf repoquery does not.
    if [[ "${ID-}" = "opensuse-leap" ]] && command -v zypper > /dev/null 2>&1; then
        local lines
        if ! lines=$(rpmspec -q --qf '%{NAME}|%{EPOCH}|%{VERSION}|%{RELEASE}\n' "${spec_file}" 2>/dev/null); then
            echo "Failed to parse spec file ${spec_file}"
            return 1
        fi

        while IFS='|' read -r name epoch version release; do
            # Skip empty lines (can happen at EOF)
            [[ -z "$name" ]] && continue

            # Normalise epoch; ignore (none)
            local evr
            if [[ -z "$epoch" || "$epoch" == "(none)" ]]; then
                evr="${version}-${release}"
            else
                evr="${epoch}:${version}-${release}"
            fi

            # Use zypper search without refreshing metadata; match exact name and VERSION-RELEASE.
            # Example row:
            #   | firewalld-ipset-braintree | package | 20250809-1.sles16 | noarch | GetPageSpeed ...
            local match
            match=$(zypper --non-interactive --no-refresh search -s -x "$name" 2>/dev/null | \
                awk -v want_name="$name" -v want_evr="$evr" '
                    $2 == want_name && $6 == want_evr { print $0 }
                ')
            if [[ -z "$match" ]]; then
                echo "Package ${name}-${evr} is NOT present in the repository."
                return 1
            fi
        done <<< "$lines"

        echo "All packages from ${spec_file} are present in the repository."
        return 0
    fi

    # Default behaviour for non-SLES: use repoquery via the universal wrapper
    # Generate the list of packages from the .spec file
    local packages
    if ! packages=$(rpmspec -q --qf '%{NAME}-%{EPOCH}:%{VERSION}-%{RELEASE}.*\n' "${spec_file}" | sed 's/(none)://g'); then
        echo "Failed to parse spec file ${spec_file}"
        return 1
    fi

    # Loop through each package and check if it exists in the repository
    for package in $packages; do
        # Use the universal_repoquery function to check if the package is present
        local result

        if ! result=$(universal_repoquery "${package}"); then
            echo "Error while checking for package ${package} in the repository."
            return 1
        fi

        # If the result is empty, it means the package is NOT present
        if [[ -z "${result}" ]]; then
            echo "Package ${package} is NOT present in the repository."
            return 1  # Exit with code 1 if any package is missing
        fi
    done

    # If all packages are present
    echo "All packages from ${spec_file} are present in the repository."
    return 0  # Exit with code 0 if all packages are present
}

# define function to build a single spec file
build_spec() {
  local specFile=$1
  if [ "$FORCE" = true ]; then
    echo "Building packages without checking repository because --force is set"
  elif check_packages_in_repo "${specFile}"; then
    echo "Skipping build for ${specFile} as all packages are present in the repository."
      return 0
  else
    echo "Building packages as some are missing upon check with repository."
  fi
  if [[ -n ${RPMLINT} && "${RPMLINT}" != 0 ]]; then
    # check the spec file for obvious errors using rpmlint
    rpmlint "$specFile"
  fi

  # install build requires
  if [[ "${ID-}" = "opensuse-leap" ]]; then
    if ! zypper_builddep "$specFile"; then
      echo "Failed to install build dependencies for $specFile"
      return 1
    fi
  else
    if ! ${BUILDDEP_CMD} -y "$specFile"; then
      pkgr clean all
      if ! ${BUILDDEP_CMD} -y "$specFile"; then
        echo "Failed to install build dependencies for $specFile"
        return 1
      fi
    fi
  fi

  # repeat step for chosen arch
  if [[ -n ${SETARCH} && "${SETARCH}" != "x86_64" ]]; then
    if [[ "${ID-}" = "opensuse-leap" ]]; then
      # Re-run zypper build deps for secondary arch context if requested
      zypper_builddep "$specFile" || true
    else
      if ! ${RPMBUILD_SETARCH} "${BUILDDEP_CMD}" -y "$specFile"; then
        pkgr clean all
        ${RPMBUILD_SETARCH} "${BUILDDEP_CMD}" -y "$specFile"
      fi
    fi
  fi

  # Fetch sources referenced by the spec. Prefer 'spectool'; on openSUSE it is named 'rpmdev-spectool'.
  SPECTOOL_CMD=""
  if command -v spectool > /dev/null 2>&1; then
    SPECTOOL_CMD="spectool"
  elif command -v rpmdev-spectool > /dev/null 2>&1; then
    SPECTOOL_CMD="rpmdev-spectool"
  fi
  if [[ -n ${SPECTOOL_CMD} ]]; then
    # A failed fetch must fail the spec NOW: this function's caller suppresses
    # set -e (|| build_exit=$?), so an unchecked fetch failure would fall
    # through and burn rpmbuild attempts against a missing tarball (incident
    # 2026-08-28: IPv6-unreachable nginx.org, curl exit 7). spectool exits 0
    # even when a download fails, so verify every remote Source/Patch landed;
    # on a miss, retry once over IPv4 with curl retries (a scoped CURL_HOME
    # curlrc reaches the curl that spectool spawns without polluting later
    # specs), then give up loudly.
    remote_sources_present() {
      local line fname missing=0
      while IFS= read -r line; do
        line=${line#*: }
        [[ ${line} == *://* ]] || continue
        fname=${line##*/}
        fname=${fname%%\?*}
        if [[ ! -f "${RPM_BUILD_SOURCES}/${fname}" ]]; then
          echo "Missing source after fetch: ${fname} (${line})"
          missing=1
        fi
      done < <(${SPECTOOL_CMD} --list-files "$1")
      return ${missing}
    }
    ${SPECTOOL_CMD} --sourcedir --get-files "$specFile" || true
    if ! remote_sources_present "$specFile"; then
      echo "Source fetch incomplete for ${specFile}; retrying once over IPv4 with retries..."
      retry_curl_home=$(mktemp -d)
      {
        [[ -f /root/.curlrc ]] && cat /root/.curlrc
        echo "ipv4"
        echo "retry = 3"
      } > "${retry_curl_home}/.curlrc"
      CURL_HOME="${retry_curl_home}" ${SPECTOOL_CMD} --sourcedir --get-files "$specFile" || true
      rm -rf "${retry_curl_home}"
      if ! remote_sources_present "$specFile"; then
        echo "FATAL: could not fetch all sources for ${specFile}; failing this spec instead of retrying rpmbuild against missing sources."
        return 1
      fi
    fi
  else
    echo "No spectool available to download sources; skipping source fetch."
  fi

  # build source RPM, also allows to fail quicker; a missing/corrupt Source
  # must stop here (see set -e suppression note above)
  if ! rpmbuild -bs "$specFile"; then
    echo "FATAL: rpmbuild -bs failed for ${specFile} (missing sources?); failing this spec early."
    return 1
  fi

  if [[ -n ${RPMLINT} && "${RPMLINT}" != 0 ]]; then
    # Source RPM built successfully. Check it using rpmlint
    if test -f /etc/rpmlint/custom.config && test -d /etc/xdg/rpmlint; then
      # if we quote the wildcard in the argument to rpmlint, it will trigger
      # to E: multiple-specfiles
      # so we need to ensure bash wildcard is used/unquoted
      rpmlint "${RPM_BUILD_SRPMS}"/*.rpm --rpmlintrc /etc/rpmlint/custom.config
    else
      rpmlint "${RPM_BUILD_SRPMS}"/*.rpm
    fi
  fi

  mv "${RPM_BUILD_SRPMS}"/*.rpm "${OUTPUT}"

  if [[ -z ${SRPM_ONLY} ]]; then

    # attempting to build RPM now
    max_attempts=10
    attempt=1
    exit_status=0

    while [ $attempt -le $max_attempts ]; do
        echo "Build attempt $attempt of $max_attempts"
        ${RPMBUILD_SETARCH} rpmbuild -ba "$specFile"
        exit_status=$?

        # Exit loop if the build succeeds or exits with a non-11 code
        [ $exit_status -ne 11 ] && break

        echo "Installing dynamic build dependencies and retrying..."
        ${BUILDDEP_CMD} -y "${RPM_BUILD_SRPMS}"/*.buildreqs.nosrc.rpm
        attempt=$((attempt +1))
    done

    if [[ -n ${RPMLINT} && "${RPMLINT}" != 0 ]]; then
      # RPMs built successfully. Check using rpmlint
      # Skip debuginfo packages from rpmlint because:
      # * their rpmlint failure is never crucial to the actual app's delivery!
      # * we can never fix these: "E: description-line-too-long C This package provides debug information for package <some lengthy name>"
      # * because there is no control of it and some packages just have to be lengthy in names
      find "${RPM_BUILD_RPMS}" -type f \
        -not -name "*-debuginfo-*" -not -name "*-debugsource-*" -name "*.rpm" \
        -exec rpmlint {} \;
    fi
    mv "${RPM_BUILD_RPMS}"/*/*.rpm "${OUTPUT}"
  fi
}

total_modules=$(find "${RPM_BUILD_SPECS}" -name "*.spec" | wc -l)
if [[ "$total_modules" -eq 0 ]]; then
  echo "No spec files found. Nothing to build."
  # Exit successfully - this is expected for infrastructure-only commits
  exit 0
fi

success_count=0
fail_count=0
# Allow configurable failure tolerance via env var (default 10%)
failure_tolerance=${FAILURE_TOLERANCE:-0.1}

# JUnit XML reporting for CircleCI "Tests" tab
RESULTS_DIR="/output/test-results"
mkdir -p "${RESULTS_DIR}"
declare -a junit_entries=()

for specFile in "${RPM_BUILD_SPECS}"/*.spec; do
  spec_name=$(basename "$specFile" .spec)
  start_time=$(date +%s)

  # Stream output to CI in real time AND capture for JUnit failure body.
  # Capturing into a shell var (build_output=$(...)) buffers everything until
  # the spec finishes, leaving CI silent for the whole build — slow aarch64
  # builds then trip CircleCI's no_output_timeout.
  #
  # `|| build_exit=$?` exempts the pipeline from the shell-wide `set -exo
  # pipefail`. Without it, a single spec's `%build` failure trips set -e,
  # the script dies before the JUnit XML write below, and CircleCI reports
  # "Found no test results, skipping". The function itself still runs under
  # set -e (so e.g. rpmbuild -ba is skipped after -bs failure); we only
  # neutralize the abort at the call site so the failure-tolerance loop
  # gets to decide.
  build_log=$(mktemp)
  build_exit=0
  build_spec "${specFile}" 2>&1 | tee "$build_log" || build_exit=$?
  build_output=$(cat "$build_log")
  rm -f "$build_log"

  end_time=$(date +%s)
  duration=$((end_time - start_time))

  if [ $build_exit -eq 0 ]; then
    success_count=$((success_count + 1))
    junit_entries+=("<testcase classname=\"rpm-build\" name=\"${spec_name}\" time=\"${duration}\"/>")
  else
    fail_count=$((fail_count + 1))
    # Escape XML special chars in output, keep last 50 lines
    escaped_output=$(echo "$build_output" | tail -50 | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')
    junit_entries+=("<testcase classname=\"rpm-build\" name=\"${spec_name}\" time=\"${duration}\"><failure message=\"Build failed\">${escaped_output}</failure></testcase>")
  fi

  fail_rate=$(echo "scale=2; $fail_count / $total_modules" | bc)
  if (( $(echo "$fail_rate > $failure_tolerance" | bc -l) )); then
    echo "Built $success_count specs successfully, but $fail_count failed out of $total_modules total spec files."
    echo "Failure tolerance exceeded. Exiting build."
    # Write partial JUnit report before exiting
    cat > "${RESULTS_DIR}/build-results.xml" <<PARTIAL_EOF
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="rpm-build" tests="$((success_count + fail_count))" failures="${fail_count}">
$(printf '%s\n' "${junit_entries[@]}")
</testsuite>
PARTIAL_EOF
    exit 1
  fi

done

# Write JUnit XML report
cat > "${RESULTS_DIR}/build-results.xml" <<JUNIT_EOF
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="rpm-build" tests="$((success_count + fail_count))" failures="${fail_count}">
$(printf '%s\n' "${junit_entries[@]}")
</testsuite>
JUNIT_EOF

# fix user IDs for output files
if [ -n "${OUTPUT_UID}" ]; then
   chown -R "${OUTPUT_UID}:${OUTPUT_UID}" "${OUTPUT}"/*
fi
